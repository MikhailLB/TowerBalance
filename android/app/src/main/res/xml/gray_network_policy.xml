<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP is permitted globally because the WebView destination loads
  partner content over redirect chains that may include plain http:// hops
  before landing on the final HTTPS page.

  User-installed CA certificates are intentionally NOT trusted — allowing them
  enables locally-installed MITM certificates, which is a Play Store review
  red flag and unrelated to the redirect issue we solve here.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
